---
import { decodeSlug, getEmDashCollection, getEmDashEntry, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Site from "../../layouts/Site.astro";
import PostCard from "../../components/PostCard.astro";
import { SHOP } from "../../data/site";
import { formatDate } from "../../utils/format";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(post, {
	siteTitle: SHOP.name,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
const cat = post.data.terms?.category?.[0];

const { entries: recent, cacheHint: recentHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 4,
});
if (Astro.cache?.enabled) Astro.cache.set(recentHint);
const others = recent.filter((p) => p.id !== post.id).slice(0, 3);
---

<Site
	title={post.data.title}
	description={seo.description ?? post.data.excerpt ?? undefined}
	image={seo.ogImage}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt?.toISOString() ?? null}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<div class="wrap"><p class="crumb"><a href="/">HOME</a> ／ <a href="/blog">ブログ</a> ／ {post.data.title}</p></div>
	<article class="article">
		<header class="article-head">
			<p class="post-meta">
				<time datetime={post.data.publishedAt?.toISOString()}>{formatDate(post.data.publishedAt)}</time>
				{cat && <a class="voice-tag" href={`/blog/category/${cat.slug}`}>{cat.label}</a>}
			</p>
			<h1>{post.data.title}</h1>
			{post.data.excerpt && <p class="article-lead">{post.data.excerpt}</p>}
		</header>
		{post.data.featured_image && (
			<div class="article-img"><Image image={post.data.featured_image} width={1200} height={800} /></div>
		)}
		<div class="prose"><PortableText value={post.data.content} /></div>
		<p class="article-back"><a class="btn btn-outline" href="/blog">記事一覧へ戻る<svg><use href="#i-arrow"></use></svg></a></p>
	</article>

	{others.length > 0 && (
		<section class="sec alt"><div class="wrap">
			<div class="sec-head"><h2>Latest</h2><p>新着記事</p></div>
			<div class="post-grid">{others.map((p) => <PostCard post={p} />)}</div>
		</div></section>
	)}
</Site>
