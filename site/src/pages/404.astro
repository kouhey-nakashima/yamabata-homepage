---
import Site from "../layouts/Site.astro";
Astro.response.status = 404;
---

<Site title="ページが見つかりません" description="お探しのページは見つかりませんでした。">
	<section class="lead-block"><div class="wrap" style="text-align:center">
		<p class="eyebrow">404</p>
		<h2>お探しのページは見つかりませんでした</h2>
		<p style="margin:0 auto 28px">移動または削除された可能性があります。</p>
		<a class="btn btn-primary" href="/">トップページへ<svg><use href="#i-arrow"></use></svg></a>
	</div></section>
</Site>
