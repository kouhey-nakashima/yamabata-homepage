---
/** LINE 友だち追加への誘導（30秒概算見積り）。PC では QR コードも表示 */
import { LINE_CTA, SHOP } from "../data/site";

interface Props {
	/** 解析用：どこに置いたボタンか */
	place: string;
}
const { place } = Astro.props;
---

<section class="line-cta" data-line={place}>
	<div class="wrap">
		<div class="line-cta__box">
			<div class="line-cta__text">
				<p class="line-cta__badge">LINE 公式アカウント</p>
				<h2>{LINE_CTA.catch.split("、").map((part, i, arr) => (i < arr.length - 1 ? <>{part}、<br class="sp-br" /></> : part))}</h2>
				<p class="line-cta__lead">{LINE_CTA.lead}</p>
				<ol class="line-cta__steps">
					{LINE_CTA.steps.map((s, i) => <li><span>{i + 1}</span>{s}</li>)}
				</ol>
				<a class="btn btn-line line-cta__btn" href={SHOP.line} target="_blank" rel="noopener" data-line={place}>
					<svg><use href="#i-chat"></use></svg>{LINE_CTA.button}
				</a>
				{LINE_CTA.note && <p class="line-cta__note">{LINE_CTA.note}</p>}
			</div>
			<div class="line-cta__qr">
				<img src="/img/line-qr.png" width="290" height="290" alt="LINE友だち追加のQRコード" loading="lazy" />
				<p>スマホのカメラで読み取って友だち追加</p>
			</div>
		</div>
	</div>
</section>
